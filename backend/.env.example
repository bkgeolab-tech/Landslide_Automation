# Đường dẫn đến file Service Account của Google Earth Engine (trong container)
# Hãy chắc chắn bạn đã đổi tên file key tải về thành gee-key.json và để ở thư mục gốc
GEE_KEY_PATH=/app/gee-key.json

# --- TÙY CHỈNH MÔ HÌNH ---
# Khoảng thời gian dự báo của ECMWF cho chế độ Realtime (mặc định 6h)
ECMWF_FORECAST_HOUR=6

# Số ngày lùi lại tối đa để tìm ảnh ECMWF mới nhất trên GEE (mặc định 5 ngày)
ECMWF_LOOKBACK_DAYS=5

# Số vòng lặp Monte Carlo (càng cao càng chính xác nhưng chạy càng lâu, mặc định 350)
MC_ITERATIONS=350

# Seed để cố định kết quả random (nếu để trống sẽ random mỗi lần chạy)
# MC_SEED=42

# --- CLOUD STORAGE (S3 / DigitalOcean Spaces) ---
# Để trống S3_BUCKET_NAME nếu muốn lưu file nội bộ (Local)
S3_BUCKET_NAME=
S3_ENDPOINT_URL=https://sgp1.digitaloceanspaces.com
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_PUBLIC_DOMAIN=
